# renders, audio and build files stay out of this folder's history
videos/*/build/
videos/*/out/*.mp4
videos/*/out/thumbnails/
videos/*/audio/
.cache/
.DS_Store
# licensed media (downloaded files) stays on this computer; the register brand/licensed/assets.json is kept
brand/licensed/*/*
!brand/licensed/*/.gitkeep
# Blender renders, frames and the terrain tile cache stay on this computer
videos/*/assets/blender/
# which optional-tool tips were shown and when (video suggest)
brand/.tips.json
__pycache__/
*.pyc
